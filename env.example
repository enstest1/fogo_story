# ---- Lil Fogees Story Engine (local dev) ----
# Copy this file to `.env` and fill in the values.
#
# NOTE: `.env` is gitignored. Do NOT commit real keys.

# Server
PORT=3001
NODE_ENV=development

# Used by `/polls/close-current` to call the protected chapter endpoint on this same server.
# Set to your public URL in production (e.g. https://your-app.onrender.com).
API_URL=http://localhost:3001

# Protects `/api/*` endpoints (chapter generation). Any random secret string is fine for local dev.
API_TOKEN=change_me_local_dev

# Supabase (Project Settings -> API)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenRouter (for Feather AI / chapter generation)
OPENROUTER_API_KEY=your_openrouter_api_key

# Poll cadence
# - production recommended: 259200 (72 hours)
# - development default: 120 (2 minutes)
POLL_DURATION_SECONDS=

# Dev scheduler frequency (seconds). Only used when NODE_ENV != production and not running on Vercel.
POLL_CRON_SECONDS=5

# Optional: OpenPipe (Feather telemetry)
OPENPIPE_API_KEY=

# Optional: Bootoshi Cloud (only needed if code paths call `cloud()` in src/lib/cloudClient.ts)
CLOUD_URL=
CLOUD_PASSWORD=

